# Model configuration (supports any LiteLLM provider: OpenAI, Anthropic, Mistral, Ollama, Gemini)
AGENT_MODEL="openai/gpt-4o"
OPENAI_API_KEY="sk-..."

# Alternative: Anthropic Claude
# AGENT_MODEL="anthropic/claude-3-7-sonnet"
# ANTHROPIC_API_KEY="sk-ant-..."

# Network & Server binding
HOST="127.0.0.1"
PORT="8081"
ENABLE_CONSOLE="true"
